# ===============================================
# BandhanSetu Server Environment Configuration
# (Placeholders only - Never commit real secrets)
# ===============================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# MongoDB Connection String
# Example local: mongodb://localhost:27017/bandhansetu
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/bandhansetu?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secrets (generate 32+ character random strings for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_placeholder
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
# delivery mode: 'development_mock' (test OTP: 123456) or 'production_sms'
OTP_DELIVERY_MODE=development_mock
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Firebase Admin Configuration (Backend only - never expose private keys)
FIREBASE_PROJECT_ID=saadibaano
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Cloudinary Storage Configuration (Backend only - never expose API secret to clients)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

