{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "BandhanSetu Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:cloudinary": "ts-node --transpile-only scripts/test-cloudinary-integration.ts",
    "test:atlas": "ts-node --transpile-only scripts/test-atlas-persistence.ts",
    "test:e2e": "ts-node --transpile-only scripts/test-matrimonial-e2e.ts",
    "create:admin": "ts-node --transpile-only scripts/create-admin.ts",
    "db:init": "ts-node --transpile-only scripts/init-all-collections.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@bandhansetu/shared": "*",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
