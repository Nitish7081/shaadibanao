# ShaadiBanao Mobile Environment Configuration

# Local Development (HTTP - Cleartext enabled for local network testing)
# For Android Emulator: http://10.0.2.2:5000/api/v1
# For Physical Device on local Wi-Fi: http://<YOUR_LOCAL_IP>:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production Deployment (HTTPS - Cleartext strictly disabled on Android)
# In production, set EXPO_PUBLIC_API_URL in your EAS Secrets / build environment:
# EXPO_PUBLIC_API_URL=https://<your-verified-production-domain>/api/v1
