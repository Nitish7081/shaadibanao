{
  "name": "bandhansetu-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "BandhanSetu - Premium Matrimonial Platform Monorepo",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run server:dev",
    "server:dev": "npm run dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "server:start": "npm run start --workspace=server",
    "server:test": "npm run test --workspace=server",
    "server:create-admin": "npm run create:admin --workspace=server --",
    "mobile:start": "npm start --workspace=@bandhansetu/mobile",
    "mobile:tunnel": "npm run start:tunnel --workspace=@bandhansetu/mobile",
    "mobile:dev": "npm run start:dev --workspace=@bandhansetu/mobile",
    "mobile:android": "npm run android --workspace=@bandhansetu/mobile",
    "mobile:build:apk": "npx eas-cli build --platform android --profile preview",
    "mobile:build:local": "npx eas-cli build --platform android --profile preview --local",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "@grpc/grpc-js": "^1.14.6",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  },
  "keywords": [
    "matrimonial",
    "react-native",
    "expo",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "BandhanSetu Team",
  "license": "UNLICENSED"
}
