{
  "name": "bandhansetu-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "BandhanSetu - Premium Matrimonial Platform Monorepo",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "server:dev": "npm run dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "server:start": "npm run start --workspace=server",
    "server:test": "npm run test --workspace=server",
    "mobile:start": "npm start --workspace=@bandhansetu/mobile",
    "mobile:android": "npm run android --workspace=@bandhansetu/mobile",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "matrimonial",
    "react-native",
    "expo",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "BandhanSetu Team",
  "license": "UNLICENSED"
}
