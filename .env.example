# ==========================================
# BandhanSetu Environment Variables Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# MongoDB Database Configuration
# Leave blank or unconfigured in early development; the health check will report db: disconnected
MONGODB_URI=mongodb://localhost:27017/bandhansetu

# JWT Secrets (Do NOT hardcode production secrets)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Mobile Client Configuration
# Android Emulator connects to localhost via 10.0.2.2.
# For physical devices over Wi-Fi, replace with your workstation LAN IP (e.g. http://192.168.1.15:5000/api/v1)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1
